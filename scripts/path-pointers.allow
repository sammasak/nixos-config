# Paths in another repository or tree, named on purpose; scripts/path-pointers.awk skips each `<file> <path>` here.
# the skills repo
CLAUDE.md scripts/bulk-read.sh
CLAUDE.md docs/operator-runbook.md
CLAUDE.md agents/coordinator/codex.toml
modules/core/agent-options.nix scripts/bulk-read.sh
docs/herdr.md agents/coordinator.md
docs/rollout-coordinator.md agents/coordinator/codex.toml
docs/rollout-coordinator.md agents/coordinator/ROLE.md
# the coordinator's state directory (~/.local/state/coordinator)
docs/rollout-coordinator.md brief/latest.md
modules/programs/cli/coordinator-wakeup.nix brief/latest.md
# factum, nix-audit, pi, devenv-platform, homelab-gitops
CLAUDE.md dev/cloud-env.sh
docs/nix-audit-pilot.md docs/USER-GUIDE.md
docs/nix-audit-pilot.md docs/PILOT.md
pkgs/nix-audit/package.nix examples/policy.toml
docs/pi.md docs/virtual-models.md
docs/pi.md docs/pi-bench.md
scripts/test-alloy-otlp-sanitizer.sh scripts/test-native-otlp-sanitizer.sh
# upstream sources (authentik, open-webui)
modules/homelab/authentik.nix ./authentik/lib/default.yml
modules/homelab/authentik.nix ./lifecycle/gunicorn.conf.py
modules/homelab/open-webui.nix backend/open_webui/__init__.py
# the lint's own example of a pointer
scripts/nix-comment-lint.sh docs/x.md
# devenv's per-checkout local overrides: untracked by design (.gitignore), hashed when present (devenv.nix builtFrom)
devenv.nix ./devenv.local.nix
devenv.nix ./devenv.local.yaml
