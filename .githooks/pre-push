#!/usr/bin/env bash
# Pre-push gate: fast lints only (comment policy + shellcheck); builds stay manual.
set -euo pipefail
# no-force-guard v4: refuse non-fast-forward pushes and deletion of
# refs/heads/main|master, on git's own stdin
# (<local ref> <local sha> <remote ref> <remote sha> per line).
# Single source of truth for this block — manual .githooks copies in
# nixos-config/claude-code-skills/homelab-gitops/knowledge must stay
# byte-identical. Bump the version marker on ANY behavioral change.
stdin=$(cat)
zeros=0000000000000000000000000000000000000000
printf '%s\n' "$stdin" | {
  while read -r _ lsha rref rsha; do
    [ -z "$rsha" ] && continue
    [ "$rsha" = "$zeros" ] && continue
    if [ "$lsha" = "$zeros" ]; then
      case "$rref" in refs/heads/main|refs/heads/master)
        echo "pre-push: deleting $rref on the remote is refused." >&2; exit 1 ;;
      esac
      continue
    fi
    if ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
      echo "pre-push: non-fast-forward to $rref refused (force push, or your view of the remote is stale — fetch first); revert with a new commit or push a branch." >&2
      exit 1
    fi
  done
} || exit 1
cd "$(git rev-parse --show-toplevel)"
just lint-comments
just lint-shell
