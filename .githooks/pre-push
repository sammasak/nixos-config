# no-force-guard v4: refuse non-fast-forward pushes and deletion of
# refs/heads/main|master, on git's own stdin
# (<local ref> <local sha> <remote ref> <remote sha> per line).
# Single source of truth for this block — manual .githooks copies in
# nixos-config/claude-code-skills/homelab-gitops/knowledge must stay
# byte-identical. Bump the version marker on ANY behavioral change.
stdin=$(cat)
zeros=0000000000000000000000000000000000000000
printf '%s\n' "$stdin" | {
  while read -r _ lsha rref rsha; do
    [ -z "$rsha" ] && continue
    [ "$rsha" = "$zeros" ] && continue
