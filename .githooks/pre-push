      case "$rref" in refs/heads/main|refs/heads/master)
        echo "pre-push: deleting $rref on the remote is refused." >&2; exit 1 ;;
      esac
      continue
    fi
    if ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
      echo "pre-push: non-fast-forward to $rref refused (force push, or your view of the remote is stale — fetch first); revert with a new commit or push a branch." >&2
      exit 1
    fi
  done
