{
  cargo-nextest,
  clippy,
  lib,
  rustPlatform,
  rustfmt,
  src,
}:
rustPlatform.buildRustPackage {
  pname = "factum";
  version = "0.2.0";
  inherit src;
  cargoLock.lockFile = "${src}/Cargo.lock";
  nativeBuildInputs = [ cargo-nextest clippy rustfmt ];
  cargoBuildFlags = [ "-p" "factum" ];
  cargoInstallFlags = [ "--path" "crates/factum" ];
  cargoTestFlags = [ "-p" "factum" ];
  postPatch = ''
    cat > fixtures/e0308_mismatch/Cargo.lock <<'EOF'
    # This file is automatically @generated by Cargo.
    # It is not intended for manual editing.
    version = 4

    [[package]]
    name = "e0308_mismatch"
    version = "0.0.0"
    EOF
  '';

  meta = {
    description = "Deterministic Rust diagnostics and impact analysis";
    homepage = "https://github.com/sammasak/factum";
    license = with lib.licenses; [ mit asl20 ];
    mainProgram = "factum";
    platforms = lib.platforms.linux;
  };
}
