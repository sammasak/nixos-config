# The acer-swift pilot template (#165): one credential-free Rust coding agent on sammasak/factum at
# the flake's pinned revision. No network and no credential: the crates are the Nix-vendored set
# (the same `importCargoLock` derivation nixos-config's factum package builds from), and the
# assignment is the lib half of that package's own check, `cargo test --release -p factum --lib`:
# a cold release build of the whole dependency graph and 243 unit tests, no network. Budgets are measured, see
# docs/agent-runtime-pilot.md.
{ config, pkgs, ... }:
let
  src = config.sam.agentRuntime.pinnedSources;
  t = config.sam.agentRuntime.templates.rust-pilot;
  repo = t.repositories.factum.path;
  # the toolchain factum's rust-toolchain.toml pins (flake-modules/05-overlays.nix builds factum with it)
  toolchain = pkgs.rust-bin.stable."1.99.0".default.override { extensions = [ "clippy" "rustfmt" ]; };
  vendored = pkgs.rustPlatform.importCargoLock { lockFile = "${src.factum}/Cargo.lock"; };
  run = pkgs.writeShellApplication {
    name = "rust-pilot-run";
    runtimeInputs = [ toolchain pkgs.cargo-nextest pkgs.gcc pkgs.coreutils pkgs.findutils ];
    text = ''
      out=''${AGENT_RUNTIME_OUTPUT:?not in an agent-runtime instance}
      export CARGO_HOME=${t.filesystem.cache.path}/cargo CARGO_BUILD_JOBS=${toString t.resources.cpus} CARGO_NET_OFFLINE=true
      # a fixed proptest seed: at this revision `prop_statement_canonical_round_trip`'s generator can draw
      # duplicate givens and fail at random (a factum bug, docs/agent-runtime-pilot.md); the pilot judges
      # the runtime, so its oracle must give the same answer every run
      export PROPTEST_RNG_SEED=165
      mkdir -p "$CARGO_HOME"
      printf '[source.crates-io]\nreplace-with = "vendored-sources"\n[source.vendored-sources]\ndirectory = "%s"\n' \
        ${vendored} >"$CARGO_HOME/config.toml"
      cd ${repo}
      # the fixture lockfile pkgs/factum/package.nix also writes: the crate ships without one
      if [ ! -e fixtures/e0308_mismatch/Cargo.lock ]; then
        printf '# This file is automatically @generated by Cargo.\n# It is not intended for manual editing.\nversion = 4\n\n[[package]]\nname = "e0308_mismatch"\nversion = "0.0.0"\n' \
          >fixtures/e0308_mismatch/Cargo.lock
      fi
      # --target-dir, not CARGO_TARGET_DIR: the variable reaches the fixture workspaces factum's tests
      # build, which then share one target directory and race
      # the lib tests: factum's integration tests build factum's own workspace again (debug, into
      # /workspace/factum/target, gigabytes), which is factum's CI, not a 2-CPU pilot
      rc=0
      cargo test --offline --locked --release --target-dir ${t.filesystem.cache.path}/target -p factum --lib \
        >"$out/cargo-test.log" 2>&1 || rc=$?
      tail -n 40 "$out/cargo-test.log"
      # what the run took of its volumes, the budgets' calibration
      used() { du -sm "$1" | cut -f1; }
      inodes() { find "$1" | wc -l; }
      printf '{"repo":"sammasak/factum","rev":"%s","command":"PROPTEST_RNG_SEED=165 cargo test --offline --locked --release -p factum --lib","exit":%d,"usedMiB":{"cache":%s,"tmp":%s,"workspace":%s},"inodes":{"cache":%s,"tmp":%s}}\n' \
        ${src.factum.rev} "$rc" "$(used ${t.filesystem.cache.path})" "$(used "$TMPDIR")" "$(used ${t.filesystem.workspace})" \
        "$(inodes ${t.filesystem.cache.path})" "$(inodes "$TMPDIR")" >"$out/result.json"
      (cd "$out" && sha256sum cargo-test.log result.json >SHA256SUMS)
      exit "$rc"
    '';
  };
in
{
  sam.agentRuntime.templates.rust-pilot = {
    role = {
      name = "rust-worker";
      harness = "claude-code";
    };
    repositories.factum = {
      github = "sammasak/factum";
      ref = {
        type = "commit";
        value = src.factum.rev;
      };
      lock = src.factum;
      path = "/workspace/factum";
      writable = true;
    };
    skillsSource = src.skills;
    skills.rust-engineering = { };
    packages = [ run toolchain pkgs.cargo-nextest pkgs.gcc pkgs.bash pkgs.coreutils pkgs.findutils pkgs.gnugrep pkgs.gawk pkgs.gnused ];
    filesystem = {
      workspaceBudget = { sizeMiB = 256; inodes = 20000; };
      home = { sizeMiB = 64; inodes = 2000; };
      tmp = { sizeMiB = 2048; inodes = 50000; };
      cache = { sizeMiB = 1024; inodes = 10000; };
      output = { sizeMiB = 64; inodes = 100; };
    };
    resources = {
      cpus = 2;
      memoryMiB = 3072;
      tasksMax = 512;
      timeoutMinutes = 20;
    };
    # network.allow stays null (no egress) and capabilities empty (no credential)
  };
}
