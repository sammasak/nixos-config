{
  "title": "Platform health",
  "uid": "platform-health",
  "tags": [
    "platform",
    "loki"
  ],
  "schemaVersion": 36,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Gates (nixos:qa on lenovo, acer-swift and msi hosts; dev-environment guests cannot reach Loki)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Seconds per step",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "max by (host, step) (max_over_time({job=\"platform\",kind=\"gate-step\"} | logfmt | unwrap seconds [1h]))",
          "legendFormat": "{{host}} {{step}}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Gate pass rate",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"platform\",kind=\"gate\"} | logfmt | result=\"pass\" [$__range])) / sum(count_over_time({job=\"platform\",kind=\"gate\"} [$__range]))",
          "queryType": "instant",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
