      "targets": [
        {
          "expr": "sum by (host, result, mode) (count_over_time({job=\"platform\",kind=\"gate\"} | logfmt [$__range]))",
          "queryType": "instant",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
