    {
      "id": 29,
      "type": "timeseries",
      "title": "Median hours by phase",
      "description": "idle: last commit to the start of its passing push gate, gate queue wait included (the platform records carry no queue time); gate: that gate's run; gate_to_merge: gate end to merge; merge_to_deploy: merge to the end of the first good recorded deploy (just deploy) whose sha has the merge. Deploy-repo PRs merged in 7 d; a PR gated outside the push hook has no gate phases (unmatched no_gate).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "expr": "shipping_pr_phase_hours{quantile=\"0.5\"}",
          "legendFormat": "{{phase}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "p90 hours by phase",
      "description": "idle: last commit to the start of its passing push gate, gate queue wait included (the platform records carry no queue time); gate: that gate's run; gate_to_merge: gate end to merge; merge_to_deploy: merge to the end of the first good recorded deploy (just deploy) whose sha has the merge. Deploy-repo PRs merged in 7 d; a PR gated outside the push hook has no gate phases (unmatched no_gate).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
