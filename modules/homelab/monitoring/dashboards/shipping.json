    {
      "id": 33,
      "type": "bargauge",
      "title": "Where a gate's time goes: average seconds per run, by gate step",
      "description": "Platform gate-step records (Loki {job=\"platform\",kind=\"gate-step\"}), every gate in the range, push or manual. nixos-flake-check is the flake check's whole step; the panel beside it splits it by check.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "targets": [
        {
          "expr": "topk(15, avg_over_time({job=\"platform\",kind=\"gate-step\"} | logfmt | check=\"\" | unwrap seconds | __error__=\"\" [$__range]) by (step))",
          "legendFormat": "{{step}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 34,
      "type": "bargauge",
      "title": "Inside the flake check: average build seconds per run, by check",
      "description": "One record per check the flake check builds (devenv.nix flakeCheck): build seconds, whether it compiled anything (result=built), only substituted (fetched) or was already in the store (present); a deferred check (result=deferred) is left out, its owner's gate builds it. Evaluation seconds are in each record's eval_seconds.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "targets": [
        {
          "expr": "topk(15, avg_over_time({job=\"platform\",kind=\"gate-step\"} | logfmt | step=\"nixos-flake-check\" | check!=\"\" | result=~\"built|fetched|present|fail\" | unwrap seconds | __error__=\"\" [$__range]) by (check))",
          "legendFormat": "{{check}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
