{
  "uid": "monitoring-stack",
  "title": "Monitoring stack",
  "description": "The monitoring itself: what black-pi scrapes and how it fares, Prometheus's storage and rules, alert delivery, the OTLP intake on acer, and each service's memory.",
  "tags": [
    "fleet",
    "monitoring"
  ],
  "editable": false,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Scrape targets",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Every scrape target now",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "up"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "down",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "up",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "description": "Each job black-pi's Prometheus scrapes and each target's up. A sleeping worker's node-exporter is 0 inside its plan (see Fleet).",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "node": true,
              "sleeps": true
            },
            "renameByName": {
              "Value": "up"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Scrape time per job (slowest target)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (job) (scrape_duration_seconds)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Prometheus (black-pi)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Head series",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(prometheus_tsdb_head_series{job=\"prometheus\"})",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Storage against its size cap",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(max(prometheus_tsdb_storage_blocks_bytes{job=\"prometheus\"}) + max(prometheus_tsdb_wal_storage_size_bytes{job=\"prometheus\"}) + max(prometheus_tsdb_head_chunks_storage_size_bytes{job=\"prometheus\"}) + max(prometheus_tsdb_out_of_order_wbl_storage_size_bytes{job=\"prometheus\"})) / max(prometheus_tsdb_retention_limit_bytes{job=\"prometheus\"})",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Blocks, WAL, head chunks and the out-of-order WBL on the SD card, as Prometheus counts them against --storage.tsdb.retention.size; at the cap it drops the oldest block, so retention shortens rather than the disk filling."
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Rule evaluation failures (range)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(prometheus_rule_evaluation_failures_total{job=\"prometheus\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Alerts not delivered to Alertmanager (range)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(prometheus_notifications_errors_total{job=\"prometheus\"}[$__range])) + sum(increase(prometheus_notifications_dropped_total{job=\"prometheus\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Send errors plus alerts dropped from the queue: a non-zero value is alerts that never reached the bridge."
    },
    {
      "id": 9,
      "type": "stat",
      "title": "WAL corruptions (range)",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(prometheus_tsdb_wal_corruptions_total{job=\"prometheus\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Samples appended per second",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(prometheus_tsdb_head_samples_appended_total{job=\"prometheus\"}[$__rate_interval]))",
          "legendFormat": "samples/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "OTLP writes from alloy-otlp, by status",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(prometheus_http_requests_total{job=\"prometheus\",handler=\"/api/v1/otlp/v1/metrics\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "The harnesses' native telemetry arrives here through acer's alloy-otlp; non-2xx is a write Prometheus refused."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Rule group duration",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (rule_group) (prometheus_rule_group_last_duration_seconds{job=\"prometheus\"})",
          "legendFormat": "{{rule_group}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Alertmanager (black-pi)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Webhook notifications to the alert bridge",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(alertmanager_notifications_total{job=\"alertmanager\",integration=\"webhook\"}[$__rate_interval]))",
          "legendFormat": "notifications",
          "refId": "A"
        },
        {
          "expr": "sum(rate(alertmanager_notifications_failed_total{job=\"alertmanager\",integration=\"webhook\"}[$__rate_interval]))",
          "legendFormat": "failed after retries",
          "refId": "B"
        },
        {
          "expr": "sum(rate(alertmanager_notification_requests_total{job=\"alertmanager\",integration=\"webhook\"}[$__rate_interval]))",
          "legendFormat": "requests (retries too)",
          "refId": "C"
        },
        {
          "expr": "sum(rate(alertmanager_notification_requests_failed_total{job=\"alertmanager\",integration=\"webhook\"}[$__rate_interval]))",
          "legendFormat": "requests failed",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "The only integration configured: the alert bridge on lenovo, which pages through ntfy. A notification counts once however many requests it takes; failed after retries is a page that did not leave, a failed request alone one that is still retrying."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Alerts held, by state",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (state) (alertmanager_alerts{job=\"alertmanager\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Suppressed are the ones an inhibit rule (a planned power-off, say) or a silence holds back."
    },
    {
      "id": 16,
      "type": "row",
      "title": "alloy-otlp (acer): the harnesses' telemetry intake",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Metric points in: accepted, refused, failed",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total{job=\"alloy-otlp\"}[$__rate_interval]))",
          "legendFormat": "accepted",
          "refId": "A"
        },
        {
          "expr": "sum(rate(otelcol_receiver_refused_metric_points_total{job=\"alloy-otlp\"}[$__rate_interval]))",
          "legendFormat": "refused",
          "refId": "B"
        },
        {
          "expr": "sum(rate(otelcol_receiver_failed_metric_points_total{job=\"alloy-otlp\"}[$__rate_interval]))",
          "legendFormat": "failed",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Log records in: accepted, refused, failed",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_accepted_log_records_total{job=\"alloy-otlp\"}[$__rate_interval]))",
          "legendFormat": "accepted",
          "refId": "A"
        },
        {
          "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"alloy-otlp\"}[$__rate_interval]))",
          "legendFormat": "refused",
          "refId": "B"
        },
        {
          "expr": "sum(rate(otelcol_receiver_failed_log_records_total{job=\"alloy-otlp\"}[$__rate_interval]))",
          "legendFormat": "failed",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Export queues against capacity",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (exporter) (otelcol_exporter_queue_size{job=\"alloy-otlp\"}) / max by (exporter) (otelcol_exporter_queue_capacity{job=\"alloy-otlp\"})",
          "legendFormat": "{{exporter}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "description": "The metrics exporter's queue to black-pi's Prometheus (logs go to Loki without one): filling up means Prometheus is not taking the writes; full, the receiver answers 503 and the senders' points show as refused."
    },
    {
      "id": 20,
      "type": "row",
      "title": "Memory",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Resident memory per service",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (job) (process_resident_memory_bytes{job!~\"node-exporter|nvidia-gpu\"})",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "description": "Each scraped service's own RSS; its module's MemoryMax is where the kernel OOM-kills the unit."
    }
  ]
}
