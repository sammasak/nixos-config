              "Value #D": "GPU offload",
              "Value #E": "Decode tok/s p50",
              "Value #F": "TTFT warm p50",
              "Value #G": "TTFT warm p95",
              "Value #H": "TTFT cold p50",
              "Value #I": "Cold load",
              "Value #J": "Agents (direct)",
              "Value #K": "Fit",
              "Value #L": "Agents (gateway)",
              "Value #M0": "headroom check",
