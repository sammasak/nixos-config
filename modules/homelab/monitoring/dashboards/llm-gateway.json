      "title": "Sleeping worker hosts (planned off is not down)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 142
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "((max by (node) (up{job=\"node-exporter\",sleeps=\"true\"} == 0) and on (node) homelab:node:planned_off) * 0 + 2) or max by (node) (up{job=\"node-exporter\",sleeps=\"true\"})",
          "refId": "A",
          "legendFormat": "{{node}}",
          "instant": true
        },
        {
          "expr": "((max by (node) (up{job=\"nvidia-gpu\"} == 0) and on (node) homelab:node:planned_off) * 0 + 2) or max by (node) (up{job=\"nvidia-gpu\"})",
          "refId": "B",
          "legendFormat": "{{node}} GPU exporter",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                },
                "2": {
                  "text": "off (planned)",
                  "color": "blue"
                }
              }
            }
          ],
          "noValue": "no GPU host declared"
        }
      },
      "description": "homelab:node:planned_off holds the value of up, so its presence, not its value, says the host may be off: 2 = off as planned, 1 = up, 0 = down outside its plan."
