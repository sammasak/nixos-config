        {
          "expr": "sum without (route) (llm_bench:agent_capacity{route=\"gateway\"})",
          "refId": "L",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sum without (check) (llm_bench:fit_check{check=\"headroom\"})",
          "refId": "M0",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sum without (check) (llm_bench:fit_check{check=\"offload\"})",
          "refId": "M1",
          "instant": true,
          "format": "table"
        },
        {
