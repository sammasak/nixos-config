{
  "title": "Loki Ingestion Health",
  "uid": "loki-ingestion-health",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "loki",
    "observability"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Distributor lines received (5m rate)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(loki_distributor_lines_received_total[5m]))",
          "legendFormat": "lines/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Distributor bytes received (5m rate)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(loki_distributor_bytes_received_total[5m]))",
          "legendFormat": "B/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "id": 3,
      "title": "Active streams",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(loki_ingester_memory_streams)",
          "legendFormat": "streams",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 10,
      "title": "Log volume per job and host",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "description": "Lines per second shipped to Loki per job and host. A gap or 0 means that job on that host is silent.",
      "targets": [
        {
          "expr": "sum by (job, host) (rate({job=~\".+\"}[5m]))",
          "legendFormat": "{{job}} {{host}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 20,
      "title": "Loki ingester rate (lines/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(rate(loki_distributor_lines_received_total[5m]))",
          "legendFormat": "ingest",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(loki_ingester_streams_created_total[5m]))",
          "legendFormat": "new streams/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 21,
      "title": "OTLP log exporter sent/dropped (5m rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "description": "Only the alloy-otlp job is scraped here. This does not cover the five host-journal writers: their Alloy metrics are loopback-only and not scraped. Missing host-journal writer counters are unknown, not zero losses. Sent and dropped are export outcomes; deliberate privacy/noise filtering is separate.",
      "targets": [
        {
          "expr": "sum(rate(loki_write_sent_entries_total{job=\"alloy-otlp\"}[5m]))",
          "legendFormat": "sent entries/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(loki_write_dropped_entries_total{job=\"alloy-otlp\"}[5m]))",
          "legendFormat": "dropped entries/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 30,
      "title": "Loki storage: chunks in memory / on disk",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum(loki_ingester_memory_chunks)",
          "legendFormat": "in-memory chunks",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(loki_chunk_store_stored_chunks_total[5m]))",
          "legendFormat": "chunks flushed/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 40,
      "title": "Host-journal counter collection success",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "description": "1 means the last loopback collection parsed the required counters; 0 means collection failed. Check age too: a stopped collector leaves old samples. Missing/sleeping hosts remain unknown. This does not prove journal completeness.",
      "targets": [
        {
          "expr": "homelab_journal_metrics_collection_success{job=\"node-exporter\"}",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 41,
      "title": "Host-journal counter collection age",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "description": "Age of the last attempt, whether successful or failed. Normal cadence is about one minute; investigate over 180 seconds while the host is known on. A fresh timestamp alone does not establish success.",
      "targets": [
        {
          "expr": "time() - homelab_journal_metrics_collection_timestamp_seconds{job=\"node-exporter\"}",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 42,
      "title": "Host-journal reader and delivered entries (5m rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "description": "Read counts include deliberate filtering; sent counts describe successful writer batches. Their difference is not an error or loss counter. Rates cross Alloy restarts using counter-reset handling; gaps remain unknown.",
      "targets": [
        {
          "expr": "sum by(node) (rate(homelab_journal_reader_lines_total{job=\"node-exporter\"}[5m]))",
          "legendFormat": "{{node}} read",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by(node) (rate(homelab_journal_writer_sent_entries_total{job=\"node-exporter\"}[5m]))",
          "legendFormat": "{{node}} sent",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 43,
      "title": "Host-journal export retries and lost entries (5m rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "description": "Writer drops are export losses; retries are batches and may later succeed. These counters do not measure privacy/noise filtering, persisted backlog or all possible crash losses. Missing counters are unknown.",
      "targets": [
        {
          "expr": "sum by(node) (rate(homelab_journal_writer_retries_total{job=\"node-exporter\"}[5m]))",
          "legendFormat": "{{node}} batch retries/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by(node,reason) (rate(homelab_journal_writer_dropped_entries_total{job=\"node-exporter\"}[5m]))",
          "legendFormat": "{{node}} {{reason}} lost entries/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 44,
      "title": "Intentional host-journal filtering (5m rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "description": "Deliberate privacy/noise filter counts, separate from delivery losses. Reasons are bounded; newly introduced reasons aggregate as other. A reason may be absent until its first event; absence is not fabricated as zero.",
      "targets": [
        {
          "expr": "sum by(node,reason) (rate(homelab_journal_filtered_lines_total{job=\"node-exporter\"}[5m]))",
          "legendFormat": "{{node}} {{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
