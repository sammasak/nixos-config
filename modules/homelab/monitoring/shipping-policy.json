{
  "alerts": {
    "OpenIssuesGrowing": {
      "days": { "value": 3, "tunedBy": "sum(shipping_issues_open{class=\"actionable\"})" }
    },
    "PrLeadTimeHigh": {
      "medianHours": { "value": 24, "tunedBy": "shipping_pr_lead_time_hours{quantile=\"0.5\"}" }
    },
    "ReviewFirstPassLow": {
      "minRatio": { "value": 0.5, "tunedBy": "shipping_review_first_pass_ratio" },
      "lastVerdicts": { "value": 20, "tunedBy": "shipping_review_prs_counted" }
    },
    "GateFailRateHigh": {
      "maxRatio": { "value": 0.3, "tunedBy": "shipping_gate_fail_ratio" },
      "lastRuns": { "value": 20, "tunedBy": "shipping_gate_runs_counted" }
    },
    "HostBehindMain": {
      "maxHours": { "value": 24, "tunedBy": "max(shipping_deploy_lag_hours)" },
      "upHours": { "value": 2, "tunedBy": "max(shipping_deploy_lag_hours)" }
    },
    "DeployRolledBack": {
      "max": { "value": 0, "tunedBy": "sum(shipping_deploy_rollbacks{window=\"24h\"})" }
    },
    "EscapeFound": {
      "max": { "value": 0, "tunedBy": "sum(shipping_escapes{window=\"24h\"})" }
    },
    "ShippingCollectorStale": {
      "maxHours": { "value": 2, "tunedBy": "(time() - min(shipping_collector_success_timestamp_seconds)) / 3600" }
    }
  },
  "review": {
    "passGrade": { "value": 9, "tunedBy": "shipping_review_first_pass_ratio" }
  },
  "issues": {
    "parkedRepos": { "value": ["herman", "karta"], "tunedBy": "sum(shipping_issues_open{class=\"parked\"})" }
  }
}
