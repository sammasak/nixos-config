{
  "alerts": {
    "OpenIssuesUntouched": {
      "days": {
        "value": 14,
        "tunedBy": "sum(shipping_issues_untouched)"
      },
      "max": {
        "value": 0,
        "tunedBy": "sum(shipping_issues_untouched)"
      },
      "forMinutes": {
        "value": 30,
        "tunedBy": "count_over_time(ALERTS{alertname=\"OpenIssuesUntouched\"}[1d])"
      }
    },
    "PrLeadTimeHigh": {
      "medianHours": {
        "value": 24,
        "tunedBy": "shipping_pr_lead_time_hours{quantile=\"0.5\"}"
      },
      "forMinutes": {
        "value": 30,
        "tunedBy": "count_over_time(ALERTS{alertname=\"PrLeadTimeHigh\"}[1d])"
      }
    },
    "LeadTimeFallbacksHigh": {
      "maxRatio": {
        "value": 0.5,
        "tunedBy": "sum(shipping_pr_lead_time_fallbacks{reason=\"http_error\",window=\"7d\"}) / sum(shipping_prs_merged{window=\"7d\"})"
      },
      "forMinutes": {
        "value": 45,
        "tunedBy": "count_over_time(ALERTS{alertname=\"LeadTimeFallbacksHigh\"}[1d])"
      }
    },
    "ReviewFirstPassLow": {
      "minRatio": {
        "value": 0.5,
        "tunedBy": "shipping_review_first_pass_ratio"
      },
      "lastVerdicts": {
        "value": 20,
        "tunedBy": "shipping_review_prs_counted"
      },
      "forMinutes": {
        "value": 30,
        "tunedBy": "count_over_time(ALERTS{alertname=\"ReviewFirstPassLow\"}[1d])"
      }
    },
    "GateFailRateHigh": {
      "maxRatio": {
        "value": 0.3,
        "tunedBy": "sum(shipping_gate_fail_ratio * shipping_gate_runs_counted) / sum(shipping_gate_runs_counted)"
      },
      "lastRuns": {
        "value": 20,
        "tunedBy": "sum(shipping_gate_runs_counted)"
      },
      "forMinutes": {
        "value": 30,
        "tunedBy": "count_over_time(ALERTS{alertname=\"GateFailRateHigh\"}[1d])"
      }
    },
    "ScheduledGateRed": {
      "forMinutes": {
        "value": 5,
        "tunedBy": "count_over_time(ALERTS{alertname=\"ScheduledGateRed\"}[1d])"
      }
    },
    "ScheduledGateOverdue": {
      "hours": {
        "value": 14,
        "tunedBy": "(time() - max(homelab_scheduled_gate_behind_since_timestamp_seconds > 0)) / 3600"
      },
      "forMinutes": {
        "value": 30,
        "tunedBy": "count_over_time(ALERTS{alertname=\"ScheduledGateOverdue\"}[1d])"
      }
    },
    "HostBehindMain": {
      "maxHours": {
        "value": 24,
        "tunedBy": "max(shipping_deploy_lag_hours)"
      },
      "upHours": {
        "value": 2,
        "tunedBy": "max(shipping_deploy_lag_hours)"
      }
    },
    "DeployRolledBack": {
      "max": {
        "value": 0,
        "tunedBy": "max(shipping_deploy_rollbacks_open{window=\"24h\"})"
      },
      "forMinutes": {
        "value": 0,
        "tunedBy": "count_over_time(ALERTS{alertname=\"DeployRolledBack\"}[1d])"
      }
    },
    "EscapeFound": {
      "max": {
        "value": 0,
        "tunedBy": "sum(shipping_escapes{window=\"24h\"})"
      },
      "forMinutes": {
        "value": 0,
        "tunedBy": "count_over_time(ALERTS{alertname=\"EscapeFound\"}[1d])"
      }
    },
    "RetroDueGateSlower": {
      "factor": {
        "value": 1.5,
        "tunedBy": "shipping_gate_seconds{quantile=\"0.5\"} / avg_over_time(shipping_gate_seconds{quantile=\"0.5\"}[7d])"
      },
      "forMinutes": {
        "value": 120,
        "tunedBy": "count_over_time(ALERTS{alertname=\"RetroDueGateSlower\"}[1d])"
      }
    },
    "RetroDueStepFailsRepeat": {
      "minFailures": {
        "value": 3,
        "tunedBy": "max(shipping_gate_step_failures{window=\"7d\"})"
      },
      "lastRuns": {
        "value": 20,
        "tunedBy": "sum(shipping_gate_runs_counted)"
      },
      "newFailureHours": {
        "value": 24,
        "tunedBy": "(time() - max(shipping_gate_step_last_failure_timestamp_seconds)) / 3600"
      },
      "forMinutes": {
        "value": 30,
        "tunedBy": "count_over_time(ALERTS{alertname=\"RetroDueStepFailsRepeat\"}[1d])"
      }
    },
    "ShippingCollectorStale": {
      "maxHours": {
        "value": 2,
        "tunedBy": "(time() - min(shipping_collector_success_timestamp_seconds)) / 3600"
      },
      "forMinutes": {
        "value": 30,
        "tunedBy": "count_over_time(ALERTS{alertname=\"ShippingCollectorStale\"}[1d])"
      },
      "minAuthenticated": {
        "value": 1,
        "tunedBy": "min(shipping_collector_authenticated)"
      }
    }
  },
  "review": {
    "passGrade": {
      "value": 9,
      "tunedBy": "shipping_review_first_pass_ratio"
    }
  },
  "issues": {
    "parkedRepos": {
      "value": [
        "herman",
        "karta"
      ],
      "tunedBy": "sum(shipping_issues_open{class=\"parked\"})"
    }
  },
  "notify": {
    "quietFromUtcHour": {
      "value": 19,
      "tunedBy": "sum(ALERTS{team=\"shipping\",alertstate=\"firing\"})"
    },
    "quietUntilUtcHour": {
      "value": 7.5,
      "tunedBy": "sum(ALERTS{team=\"shipping\",alertstate=\"firing\"})"
    }
  }
}
