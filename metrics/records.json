    },
    "trash-sweep": {
      "writer": "here",
      "guest": false,
      "fields": [
        "seen",
        "deleted",
        "bytes",
        "result"
      ]
    },
    "review": {
      "writer": "outside",
      "guest": true,
      "fields": [
