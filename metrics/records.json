{
  "about": "Every platform record kind and the fields it may carry (pkgs/platform-record, scripts/test-platform-records.py). writer: here = a caller in this repo; outside = another repo's tool through platform-record (reviewer panes, research, devenv-platform's pi-offload, the app release script); host = the host ships it to Loki itself, not through platform-record (scripts/guest-records.py). guest: a dev-environment guest may ship it (modules/workers/default.nix records.kinds). panel: the dashboard that shows it, platform-health (modules/homelab/monitoring/dashboards/platform-health.json) when absent, pi-agents (modules/homelab/monitoring/dashboards/pi-agents.json), or false for none yet. optional: fields a kind may also carry that no caller here writes yet (another branch or repo does); the writer accepts them, the test does not ask for a caller. pending: a here kind whose caller is on a branch not merged yet (the test fails once a caller exists and pending is still set).",
  "kinds": {
    "gate": {
      "writer": "here",
      "guest": true,
      "fields": [
        "gate",
        "seconds",
        "result",
        "sha",
        "mode",
        "deferred",
        "head",
        "checkout",
        "deferred_checks",
        "wait_seconds"
      ]
    },
    "gate-step": {
      "writer": "here",
      "guest": true,
      "fields": [
        "gate",
        "step",
        "check",
        "owner",
        "seconds",
        "eval_seconds",
        "compiled",
        "fetched",
        "result",
        "head",
        "drv",
        "sha"
      ]
    },
    "deploy": {
      "writer": "here",
      "guest": false,
      "fields": [
        "node",
        "result",
        "seconds",
        "rolled_back",
        "units_restarted",
        "failed_units",
        "sha"
      ],
      "optional": [
        "free_gib",
        "closure_gib",
        "floor_gib",
        "headroom"
      ]
    },
    "checks-run": {
      "writer": "here",
      "guest": true,
      "fields": [
        "node",
        "check",
        "status"
      ]
    },
    "coverage": {
      "writer": "here",
      "guest": true,
      "fields": [
        "node",
        "assertions",
        "system_checks"
      ]
    },
    "instructions": {
      "writer": "here",
      "guest": true,
      "fields": [
        "file",
        "bytes"
      ]
    },
    "delivery": {
